---
import { prefixedLocales } from "../../i18n/ui";
import SobreView from "../../views/SobreView.astro";

// One page per prefixed locale. The default locale (de) is served from the
// unprefixed route at src/pages/sobre.astro.
export function getStaticPaths() {
  return prefixedLocales.map((lang) => ({ params: { lang } }));
}
---
<SobreView />