---
import { getCollection } from "astro:content";
import ObraDetailView from "../../views/ObraDetailView.astro";

export async function getStaticPaths() {
  const obras = await getCollection("obras");
  const locale = "de";
  const localized = obras.filter((o) => (o.data.lang ?? "es") === locale);
  return localized.map((obra) => ({
    params: { slug: obra.id.split("/").pop() ?? obra.id },
    props: { obra },
  }));
}
---
<ObraDetailView obra={Astro.props.obra} />