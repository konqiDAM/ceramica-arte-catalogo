---
import { isLocale } from "../i18n/ui";
import { url } from "../lib/url";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "de";
const rawPath = Astro.url.pathname.replace(/^\/(en|es)(?=\/|$)/, "");
const cleanPath = rawPath.replace(/^\/+/, "");
const langs = [
  { code: "de", label: "DE" },
  { code: "en", label: "EN" },
  { code: "es", label: "ES" },
];

// Build locale-aware URL manually to respect BASE_PATH
function getLocaleUrl(langCode: string, path: string) {
  const cleanPath = path.replace(/^\/+/, "");
  if (langCode === "de") {
    return cleanPath ? `/${cleanPath}` : "/";
  }
  return cleanPath ? `/${langCode}/${cleanPath}` : `/${langCode}`;
}
---
<nav aria-label="Language" class="lang-switch">
  {langs.map((l) => (
    <a
      href={url(getLocaleUrl(l.code, cleanPath))}
      class:list={[{ active: l.code === locale }]}
      aria-current={l.code === locale ? "true" : undefined}
    >
      {l.label}
    </a>
  ))}
</nav>

<style>
  .lang-switch {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .lang-switch a {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .lang-switch a.active {
    background: var(--clay);
    color: #fff;
    border-color: var(--clay);
  }
</style>