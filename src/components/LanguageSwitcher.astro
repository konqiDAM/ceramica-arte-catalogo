---
import { defaultLocale, isLocale, localePrefixPattern, locales } from "../i18n/ui";
import { localeUrl } from "../lib/url";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
// Remove BASE_PATH from pathname, then remove locale prefix, then clean leading slashes
const rawPath = Astro.url.pathname.replace(new RegExp(`^${basePath.replace(/\//g, "\\/")}`, ""), "").replace(localePrefixPattern, "");
const cleanPath = rawPath.replace(/^\/+/, "");
---

<nav aria-label="Language" class="lang-switch">
  {locales.map((code) => (
    <a
      href={localeUrl(cleanPath || "/", code)}
      class:list={[{ active: code === locale }]}
      aria-current={code === locale ? "true" : undefined}
      hreflang={code}
    >
      {code.toUpperCase()}
    </a>
  ))}
</nav>

<style>
  .lang-switch {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .lang-switch a {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .lang-switch a.active {
    background: var(--clay);
    color: #fff;
    border-color: var(--clay);
  }
</style>