---
import { isLocale } from "../i18n/ui";
import { localeUrl } from "../lib/url";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : "de";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
// Remove BASE_PATH from pathname, then remove locale prefix, then clean leading slashes
const rawPath = Astro.url.pathname.replace(new RegExp(`^${basePath.replace(/\//g, "\\/")}`, ""), "").replace(/^\/(en|es)(?=\/|$)/, "");
const cleanPath = rawPath.replace(/^\/+/, "");
const langs = [
  { code: "de", label: "DE" },
  { code: "en", label: "EN" },
  { code: "es", label: "ES" },
];
---
<nav aria-label="Language" class="lang-switch">
  {langs.map((l) => (
    <a
      href={localeUrl(cleanPath || "/", l.code)}
      class:list={[{ active: l.code === locale }]}
      aria-current={l.code === locale ? "true" : undefined}
    >
      {l.label}
    </a>
  ))}
</nav>

<style>
  .lang-switch {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .lang-switch a {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .lang-switch a.active {
    background: var(--clay);
    color: #fff;
    border-color: var(--clay);
  }
</style>