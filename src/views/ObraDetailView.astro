---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryLabel, defaultLocale, isLocale, t } from "../i18n/ui";
import { url, localeUrl } from "../lib/url";
import { getCollection, render } from "astro:content";

interface Props {
  obra: any;
}
const { obra } = Astro.props;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;

const { Content } = await render(obra);
const d = obra.data;

const all = await getCollection("obras");
const localized = all.filter((o) => o.data.lang === locale);
const obraSlug = obra.id.split("/").pop() ?? obra.id;
const relacionadas = localized
  .filter((o) => (o.id.split("/").pop() ?? o.id) !== obraSlug && o.data.categoria === d.categoria)
  .slice(0, 3);
---
<BaseLayout title={d.titulo} description={d.descripcion}>
  <section class="detail">
    <div class="container">
      <a href={localeUrl("/catalogo", locale)} class="back">{t(locale, "obra.detail.back")}</a>
      <div class="detail-grid">
        <div class="detail-media" style={`--bg: url(${url(d.imagen)})`}>
          <img src={url(d.imagen)} alt={d.titulo} width="500" height="500" />
        </div>
        <div class="detail-info">
          <p class="eyebrow">{categoryLabel(locale, d.categoria)}</p>
          <h1>{d.titulo}</h1>
          <p class="lead">{d.descripcion}</p>

          <div class="prose"><Content /></div>

          <dl class="specs">
            {d.materiales && (<><dt>{t(locale, "obra.detail.materials")}</dt><dd>{d.materiales}</dd></>)}
            {d.dimensiones && (<><dt>{t(locale, "obra.detail.dimensions")}</dt><dd>{d.dimensiones}</dd></>)}
            {d.anio && (<><dt>{t(locale, "obra.detail.year")}</dt><dd>{d.anio}</dd></>)}
            <dt>{t(locale, "obra.detail.availability")}</dt>
            <dd>{d.disponible ? t(locale, "obra.detail.available") : t(locale, "obra.detail.sold")}</dd>
          </dl>

          <div class="detail-cta">
            <a href={`${localeUrl("/contacto", locale)}?pieza=${encodeURIComponent(obraSlug)}`} class="btn btn-primary">
              {t(locale, "obra.detail.consult")}
            </a>
            <a href={localeUrl("/contacto", locale)} class="btn btn-ghost">{t(locale, "obra.detail.contact")}</a>
          </div>
        </div>
      </div>

      {
        relacionadas.length > 0 && (
          <div class="related">
            <h2>{t(locale, "obra.detail.related", { category: categoryLabel(locale, d.categoria) })}</h2>
            <div class="related-grid">
              {relacionadas.map((o) => (
                <a href={localeUrl(`/obra/${o.id.split("/").pop() ?? o.id}`, locale)} class="related-card" style={`--bg: url(${url(o.data.imagen)})`}>
                  <img src={url(o.data.imagen)} alt={o.data.titulo} width="500" height="500" />
                  <span>{o.data.titulo}</span>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .detail { padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(3rem, 6vw, 5rem); }
  .back { display: inline-block; margin-bottom: 1.5rem; font-weight: 500; }
  .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .detail-media img { max-width: 100%; max-height: min(80vh, 720px); width: auto; height: auto; display: block; margin: 0 auto; border-radius: var(--radius); box-shadow: var(--shadow); position: sticky; top: 96px; }
  .prose { color: var(--ink); margin-bottom: 1.5rem; }
  .specs { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem 1.5rem; padding: 1.3rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 1.8rem; }
  .specs dt { color: var(--muted); font-size: 0.9rem; }
  .specs dd { margin: 0; font-weight: 500; }
  .detail-cta { display: flex; gap: 1rem; flex-wrap: wrap; }
  .related { margin-top: 4rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.2rem; margin-top: 1.2rem; }
  .related-card { color: var(--ink); }
  .related-card img { border-radius: var(--radius); aspect-ratio: 1 / 1; object-fit: cover; margin-bottom: 0.6rem; box-shadow: var(--shadow); }
  .related-card span { font-weight: 500; }
  @media (max-width: 780px) { .detail-grid { grid-template-columns: 1fr; gap: 2rem; } .detail-media img { position: static; max-height: 60vh; } }
</style>