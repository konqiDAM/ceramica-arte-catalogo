<BaseLayout title={t(locale, "galeria.title")} description={t(locale, "galeria.description")}>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">{t(locale, "galeria.eyebrow")}</p>
      <h1>{t(locale, "galeria.heading")}</h1>
      <p class="lead">{t(locale, "galeria.lead")}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="gallery">
        {fotos.map((src, i) => (
          <figure class="gallery-item" style={`--bg: url(${url(src)})`}>
            <img src={url(src)} alt={t(locale, "galeria.img.alt", { n: i + 1 })} loading="lazy" width="600" height="600" />
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding: clamp(2.5rem, 6vw, 4rem) 0 0; }
  .page-head .lead { margin-top: 0.5rem; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; }
  .gallery-item { margin: 0; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: var(--sand); aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; position: relative; }
  .gallery-item::before { content: ""; position: absolute; inset: -16px; background-image: var(--bg); background-size: cover; background-position: center; filter: blur(18px) saturate(1.15); transform: scale(1.15); z-index: 0; }
  .gallery-item img { position: relative; z-index: 1; display: block; width: 100%; height: 100%; object-fit: contain; transition: transform 0.3s ease; }
  .gallery-item:hover img { transform: scale(1.04); }
</style>